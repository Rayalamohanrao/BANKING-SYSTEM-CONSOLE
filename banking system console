
#include <stdio.h>
#include <string.h>

#define MAX 100

struct Account {
    int accountNumber;
    char name[50];
    float balance;
};

struct Account accounts[MAX];
int count = 0;

int findAccount(int accountNumber) {
    for (int i = 0; i < count; i++) {
        if (accounts[i].accountNumber == accountNumber)
            return i;
    }
    return -1;
}

void createAccount() {
    if (count >= MAX) {
        printf("\nAccount limit reached!\n");
        return;
    }

    int acc;
    printf("\nEnter account number: ");
    scanf("%d", &acc);

    if (findAccount(acc) != -1) {
        printf("Account already exists!\n");
        return;
    }

    accounts[count].accountNumber = acc;

    printf("Enter account holder name: ");
    scanf(" %49[^\n]", accounts[count].name);

    printf("Enter initial deposit: Rs. ");
    scanf("%f", &accounts[count].balance);

    if (accounts[count].balance < 0) {
        printf("Invalid deposit amount!\n");
        return;
    }

    count++;
    printf("\nAccount created successfully!\n");
}

void depositMoney() {
    int acc, index;
    float amount;

    printf("\nEnter account number: ");
    scanf("%d", &acc);

    index = findAccount(acc);

    if (index == -1) {
        printf("Account not found!\n");
        return;
    }

    printf("Enter deposit amount: Rs. ");
    scanf("%f", &amount);

    if (amount <= 0) {
        printf("Invalid amount!\n");
        return;
    }

    accounts[index].balance += amount;
    printf("Deposit successful!\n");
    printf("New balance: Rs. %.2f\n",
           accounts[index].balance);
}

void withdrawMoney() {
    int acc, index;
    float amount;

    printf("\nEnter account number: ");
    scanf("%d", &acc);

    index = findAccount(acc);

    if (index == -1) {
        printf("Account not found!\n");
        return;
    }

    printf("Enter withdrawal amount: Rs. ");
    scanf("%f", &amount);

    if (amount <= 0) {
        printf("Invalid amount!\n");
    } else if (amount > accounts[index].balance) {
        printf("Insufficient balance!\n");
    } else {
        accounts[index].balance -= amount;
        printf("Withdrawal successful!\n");
        printf("Remaining balance: Rs. %.2f\n",
               accounts[index].balance);
    }
}

void checkBalance() {
    int acc, index;

    printf("\nEnter account number: ");
    scanf("%d", &acc);

    index = findAccount(acc);

    if (index == -1) {
        printf("Account not found!\n");
        return;
    }

    printf("\nAccount Holder: %s\n", accounts[index].name);
    printf("Account Number: %d\n", accounts[index].accountNumber);
    printf("Available Balance: Rs. %.2f\n",
           accounts[index].balance);
}

void displayAccounts() {
    if (count == 0) {
        printf("\nNo accounts available.\n");
        return;
    }

    printf("\n========== ACCOUNT LIST ==========\n");

    for (int i = 0; i < count; i++) {
        printf("\nAccount Number: %d\n",
               accounts[i].accountNumber);
        printf("Holder Name: %s\n", accounts[i].name);
        printf("Balance: Rs. %.2f\n", accounts[i].balance);
    }
}

int main() {
    int choice;

    do {
        printf("\n\n================================\n");
        printf("       BANKING SYSTEM\n");
        printf("================================\n");
        printf("1. Create Account\n");
        printf("2. Deposit Money\n");
        printf("3. Withdraw Money\n");
        printf("4. Check Balance\n");
        printf("5. Display All Accounts\n");
        printf("6. Exit\n");
        printf("================================\n");
        printf("Enter your choice: ");

        if (scanf("%d", &choice) != 1) {
            printf("Invalid input. Please restart the program.\n");
            return 1;
        }

        switch (choice) {
            case 1:
                createAccount();
                break;
            case 2:
                depositMoney();
                break;
            case 3:
                withdrawMoney();
                break;
            case 4:
                checkBalance();
                break;
            case 5:
                displayAccounts();
                break;
            case 6:
                printf("\nThank you for using our banking system!\n");
                break;
            default:
                printf("\nInvalid choice! Try again.\n");
        }
    } while (choice != 6);

    return 0;
}
